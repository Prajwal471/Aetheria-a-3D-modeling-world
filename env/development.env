# Development Environment Configuration
# Copy this file to .env.local in your project root

# Firebase Configuration (Development)
NEXT_PUBLIC_FIREBASE_API_KEY=your_dev_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-dev-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-dev-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-dev-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Google Cloud Configuration (Development)
GOOGLE_CLOUD_PROJECT_ID=your-dev-project
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI Configuration (Development)
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_NAME=imagen-3.0-generate-001

# Development-specific settings
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug

# API Endpoints (Development)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3001

# Feature Flags (Development)
NEXT_PUBLIC_ENABLE_AI_GENERATION=true
NEXT_PUBLIC_ENABLE_VOICE_CHAT=true
NEXT_PUBLIC_ENABLE_PHYSICS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Development Tools
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_ENABLE_HOT_RELOAD=true
NEXT_PUBLIC_ENABLE_ERROR_BOUNDARY=true

# Database (Development)
DATABASE_URL=postgresql://localhost:5432/aetheria_dev
REDIS_URL=redis://localhost:6379

# External Services (Development)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
SENDGRID_API_KEY=your_sendgrid_key
