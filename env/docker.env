# Docker Environment Configuration
# Used for containerized deployments

# Firebase Configuration (Docker)
NEXT_PUBLIC_FIREBASE_API_KEY=${FIREBASE_API_KEY}
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${FIREBASE_AUTH_DOMAIN}
NEXT_PUBLIC_FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID}
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${FIREBASE_STORAGE_BUCKET}
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${FIREBASE_MESSAGING_SENDER_ID}
NEXT_PUBLIC_FIREBASE_APP_ID=${FIREBASE_APP_ID}

# Google Cloud Configuration (Docker)
GOOGLE_CLOUD_PROJECT_ID=${GOOGLE_CLOUD_PROJECT_ID}
GOOGLE_CLOUD_REGION=${GOOGLE_CLOUD_REGION:-us-central1}

# Vertex AI Configuration (Docker)
VERTEX_AI_LOCATION=${VERTEX_AI_LOCATION:-us-central1}
VERTEX_AI_MODEL_NAME=${VERTEX_AI_MODEL_NAME:-imagen-3.0-generate-001}

# Environment settings
NODE_ENV=${NODE_ENV:-production}
NEXT_PUBLIC_APP_ENV=${APP_ENV:-production}
NEXT_PUBLIC_DEBUG_MODE=${DEBUG_MODE:-false}
NEXT_PUBLIC_LOG_LEVEL=${LOG_LEVEL:-info}

# API Endpoints (Docker)
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}
NEXT_PUBLIC_WEBSOCKET_URL=${WEBSOCKET_URL}

# Feature Flags (Docker)
NEXT_PUBLIC_ENABLE_AI_GENERATION=${ENABLE_AI_GENERATION:-true}
NEXT_PUBLIC_ENABLE_VOICE_CHAT=${ENABLE_VOICE_CHAT:-true}
NEXT_PUBLIC_ENABLE_PHYSICS=${ENABLE_PHYSICS:-true}
NEXT_PUBLIC_ENABLE_ANALYTICS=${ENABLE_ANALYTICS:-true}

# Database (Docker)
DATABASE_URL=${DATABASE_URL}
REDIS_URL=${REDIS_URL}

# External Services (Docker)
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
SENDGRID_API_KEY=${SENDGRID_API_KEY}

# Security (Docker)
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
NEXTAUTH_URL=${NEXTAUTH_URL}

# Monitoring (Docker)
SENTRY_DSN=${SENTRY_DSN}
ANALYTICS_ID=${ANALYTICS_ID}

# Docker-specific settings
PORT=${PORT:-3000}
HOST=${HOST:-0.0.0.0}
