# API Endpoints (Production)
NEXT_PUBLIC_API_BASE_URL=https://api.aetheria.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://api.aetheria.com

# Feature Flags (Production)
NEXT_PUBLIC_ENABLE_AI_GENERATION=true
NEXT_PUBLIC_ENABLE_VOICE_CHAT=true
NEXT_PUBLIC_ENABLE_PHYSICS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Production Tools
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false
NEXT_PUBLIC_ENABLE_HOT_RELOAD=false
NEXT_PUBLIC_ENABLE_ERROR_BOUNDARY=true

# Database (Production)
DATABASE_URL=postgresql://prod_user:prod_password@prod_host:5432/aetheria_prod
