# Staging Environment Configuration
# Copy this file to .env.local in your project root

# Firebase Configuration (Staging)
NEXT_PUBLIC_FIREBASE_API_KEY=your_staging_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-staging-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-staging-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=555666777
NEXT_PUBLIC_FIREBASE_APP_ID=1:555666777:web:staging123456

# Google Cloud Configuration (Staging)
GOOGLE_CLOUD_PROJECT_ID=your-staging-project
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI Configuration (Staging)
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_NAME=imagen-3.0-generate-001

# Staging-specific settings
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=warn

# API Endpoints (Staging)
NEXT_PUBLIC_API_BASE_URL=https://staging-api.aetheria.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://staging-api.aetheria.com

# Feature Flags (Staging)
NEXT_PUBLIC_ENABLE_AI_GENERATION=true
NEXT_PUBLIC_ENABLE_VOICE_CHAT=true
NEXT_PUBLIC_ENABLE_PHYSICS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Staging Tools
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_ENABLE_HOT_RELOAD=false
NEXT_PUBLIC_ENABLE_ERROR_BOUNDARY=true

# Database (Staging)
DATABASE_URL=postgresql://staging_user:staging_password@staging_host:5432/aetheria_staging
REDIS_URL=redis://staging_redis_host:6379

# External Services (Staging)
STRIPE_PUBLISHABLE_KEY=pk_test_your_staging_stripe_key
SENDGRID_API_KEY=your_staging_sendgrid_key

# Security (Staging)
NEXTAUTH_SECRET=your_staging_nextauth_secret
NEXTAUTH_URL=https://staging.aetheria.com

# Monitoring (Staging)
SENTRY_DSN=your_staging_sentry_dsn
ANALYTICS_ID=your_staging_analytics_id
